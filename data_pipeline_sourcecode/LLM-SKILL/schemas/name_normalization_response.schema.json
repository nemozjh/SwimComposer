{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swimcomposer.example/schemas/name_normalization_response.schema.json",
  "title": "Name Normalization LLM Response",
  "type": "object",
  "required": ["segments"],
  "additionalProperties": false,
  "properties": {
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "normalized_text", "mentions"],
        "additionalProperties": false,
        "properties": {
          "segment_id": {"type": "integer"},
          "normalized_text": {"type": "string"},
          "mentions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["spoken_form", "normalized_name", "confidence", "rationale"],
              "additionalProperties": false,
              "properties": {
                "spoken_form": {"type": "string"},
                "normalized_name": {"type": "string"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "rationale": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
