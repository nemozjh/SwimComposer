{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swimcomposer.example/schemas/insight_extraction_response.schema.json",
  "title": "Insight Extraction LLM Response",
  "type": "object",
  "required": ["insights"],
  "additionalProperties": false,
  "properties": {
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_segment_id", "category", "start_sec", "end_sec", "summary", "athlete_names", "confidence"],
        "additionalProperties": false,
        "properties": {
          "source_segment_id": {"type": "integer"},
          "category": {
            "type": "string",
            "enum": ["lead_change", "lead_status", "record_watch", "tech_review", "chase", "result"]
          },
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "minimum": 0},
          "summary": {"type": "string"},
          "athlete_names": {"type": "array", "items": {"type": "string"}},
          "target_names": {"type": "array", "items": {"type": "string"}, "default": []},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
